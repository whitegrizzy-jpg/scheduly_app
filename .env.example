# Firebase 설정 키 목록 (실제 값은 넣지 마세요)
# 1) 이 파일을 복사해 같은 폴더에 .env 를 만들고 값을 채웁니다:  cp .env.example .env
# 2) 실행:  flutter run --dart-define-from-file=.env
# 값은 Firebase 콘솔 > 프로젝트 설정 > 내 앱(Android) 에서 확인합니다.
# .env 는 .gitignore 에 들어 있어 커밋·제출되지 않습니다.
# 값이 비어 있으면 앱은 서버 동기화 없이 "로컬 전용 모드"로 동작합니다.

FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
